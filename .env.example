# 이 파일을 복사해서 .env 로 저장한 뒤 키 값을 채워주세요.
# .env 는 git 에 올라가지 않습니다(.gitignore 처리됨).

# Claude API 키 (사진 분석 + 글 작성)  https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Gemini API 키 (썸네일/대표사진 생성, 선택)  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (선택) 핸드폰/네트워크에서 접속 시 비밀번호 잠금. 비워두면 잠금 없음.
APP_PASSWORD=

# 공용 저장소 Supabase (폰 클라우드 앱 ↔ 맥 포스터)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=서비스롤_키(service_role)
SUPABASE_BUCKET=media
